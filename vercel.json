{
  "version": 2,
  "buildCommand": "./build.sh",
  "outputDirectory": "staticfiles",
  "functions": {
    "api/index.py": {
      "runtime": "python3.10"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}